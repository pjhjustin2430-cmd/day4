# 이 파일을 복사해서 `.env.local` 로 만든 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# ── 브라우저에 노출되어도 되는 값 (VITE_ 접두사) ─────────────────────────
# Supabase 대시보드 → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# anon(public) 키 또는 Publishable 키. ※ service_role / secret 키는 절대 넣지 마세요!
VITE_SUPABASE_ANON_KEY=

# ── 서버 전용 값 (VITE_ 접두사를 붙이면 브라우저에 노출되니 붙이지 마세요) ──
# https://pixabay.com/api/docs/ 로그인 후 "Your API key"
PIXABAY_API_KEY=
# 공공데이터포털(data.go.kr) → 마이페이지 → 데이터 활용 → 활용신청 현황 → 「서귀포시_직영관광지 관람객수 추이」 → 일반 인증키
DATA_GO_KR_API_KEY=
